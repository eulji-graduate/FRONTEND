# 견본 — 이 파일을 `.env.local`로 복사해 값을 채운다. 실제 값은 여기 적지 않는다(커밋된다).
# 값은 졸업작품 방에서 받는다.
# ⚠️ 쓰지 않는 변수는 빈 값(`X=`)으로 두지 말고 주석으로 둔다 — `BACKEND_API_URL=`처럼 빈
#    문자열이 들어가면 기본값(localhost:8080)으로 안 떨어지고 주소가 비어 버린다.

# 목 ↔ 실제 BE. 없으면 목 모드. 실제 BE에 붙이려면 false
# NEXT_PUBLIC_USE_MOCK=false

# BE 주소(서버 전용). 없으면 http://localhost:8080
# BACKEND_API_URL=http://localhost:8080

# /system 시스템 관리자 로그인. 없으면 로그인 시도 때 오류
SYSTEM_ADMIN_ID=
SYSTEM_ADMIN_PASSWORD=

# 카카오 지도·주소 검색. 없으면 직접 입력으로 대체
# 쓰려면 카카오 개발자 콘솔에 http://localhost:3000 을 등록해야 한다
# NEXT_PUBLIC_KAKAO_MAP_KEY=

# 로그 수집(Loki). 없으면 보내지 않는다
# LOKI_URL=http://localhost:3100

# 메타데이터 기준 URL. 없으면 http://localhost:3000
# NEXT_PUBLIC_SITE_URL=
